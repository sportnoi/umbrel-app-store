# Copy to proxy.env and edit. Referenced by lan-proxy.service and compose.yml.

# The proxy's own LAN address. Must be OUTSIDE the UniFi DHCP pool — if DHCP can
# hand it to another device you get an address conflict that presents as
# intermittent, baffling failures.
PROXY_IP=192.168.1.50

# Your LAN, and the interface carrying it. Check with:
#   ip route get 1.1.1.1
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1
LAN_PARENT=wlp1s0
